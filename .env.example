# Application
APP_NAME=ERPNext Agent
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8001
APP_BASE_URL=http://localhost:8001
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TRUSTED_HOSTS=localhost,127.0.0.1,agent
CORS_ORIGINS=http://localhost:3000,http://localhost:8001
AUTO_CREATE_SCHEMA=true

# Docker Compose infrastructure
POSTGRES_DB=erpnext_agent
POSTGRES_USER=erpnext_agent
POSTGRES_PASSWORD=change-me-database-password
REDIS_PASSWORD=change-me-redis-password
DATABASE_URL=postgresql+asyncpg://erpnext_agent:change-me-database-password@postgres:5432/erpnext_agent
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ERPNext public browser URL and container-internal URL.
ERPNEXT_BASE_URL=http://dev.localhost:8000
ERPNEXT_INTERNAL_URL=http://frappe:8000
ERPNEXT_MCP_URL=http://frappe:8000/api/method/erpnext_mcp_tools.mcp.handle_mcp
ERPNEXT_SITE=dev.localhost
# Existing Frappe devcontainer network that the Agent joins for internal traffic.
FRAPPE_DOCKER_NETWORK=frappe_docker_devcontainer_default
MCP_HTTP_TIMEOUT_SECONDS=20
MCP_EXECUTION_TIMEOUT_SECONDS=25
MCP_VERIFY_TOOL_CONTRACT=true

# ERPNext OAuth 2.0 Authorization Code + PKCE
OAUTH_CLIENT_ID=replace-with-erpnext-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-erpnext-oauth-client-secret
# Current Frappe dev server accepts confidential clients reliably via form credentials.
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/callback
OAUTH_SCOPE=all openid
OAUTH_STATE_TTL_SECONDS=600
OAUTH_REFRESH_LEEWAY_SECONDS=120
OAUTH_REFRESH_LOCK_TTL_SECONDS=60
OAUTH_REFRESH_WAIT_SECONDS=25
OAUTH_REFRESH_POLL_SECONDS=0.1

# Browser session and encrypted token storage
SESSION_COOKIE_NAME=erpnext_agent_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
SESSION_SECRET=replace-with-at-least-32-random-characters
# Fernet key: `openssl rand -base64 32 | tr '+/' '-_'` (replace this development-only value)
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOKEN_ENCRYPTION_KEY_VERSION=v1

# Persistent human approval
ACTION_TTL_SECONDS=900
ACTION_RECOVERY_ENABLED=true
ACTION_RECOVERY_POLL_SECONDS=15
ACTION_RECOVERY_RETRY_SECONDS=60
ACTION_RECOVERY_BATCH_SIZE=20
# Must cover identity check, token refresh, same-key write retry and readback.
ACTION_EXECUTION_LOCK_TTL_SECONDS=300

# PostgreSQL-backed conversation memory
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_CHARS=24000
CHAT_HISTORY_DISPLAY_LIMIT=100
CHAT_CONVERSATION_LIST_LIMIT=50
CHAT_SUMMARY_ENABLED=true
CHAT_SUMMARY_TRIGGER_MESSAGES=16
CHAT_SUMMARY_TRIGGER_CHARS=16000
CHAT_SUMMARY_KEEP_RECENT_MESSAGES=8
CHAT_SUMMARY_SOURCE_MAX_CHARS=24000
CHAT_SUMMARY_MAX_CHARS=4000
CHAT_SUMMARY_LOCK_TTL_SECONDS=120

# AgentScope model. Providers: dashscope, openai, openai_compatible.
# DashScope example: MODEL_PROVIDER=dashscope, MODEL_NAME=qwen-plus; MODEL_BASE_URL may stay empty.
# OpenAI-compatible services must set MODEL_BASE_URL to their OpenAI-compatible API endpoint.
MODEL_PROVIDER=openai_compatible
MODEL_NAME=replace-with-model-name
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_MAX_RETRIES=1

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=erpnext-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
